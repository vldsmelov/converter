# Шаблон для docker-compose.vps.yml (СБ: секреты только здесь на сервере, файл deploy/vps/.env в .gitignore).
# Скопировать: cp deploy/vps/.env.example deploy/vps/.env && chmod 600 deploy/vps/.env
#
# Форк vvv-web — можно менять переменные для экспериментов; для прода согласовать с ИБ.

# --- RabbitMQ (только внутри docker-сети, без publish на хост) ---
RABBITMQ_USER=converter_mq
RABBITMQ_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- MinIO ---
MINIO_ROOT_USER=converter_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- Keycloak: БД админа realm ---
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Публичное имя Keycloak за Nginx (HTTPS). СБ: строгий hostname.
KEYCLOAK_HOSTNAME=converter.example.com

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_ADMIN

# --- PostgreSQL приложений ---
NSI_DB_USER=nsi
NSI_DB_PASSWORD=CHANGE_ME_NSI_DB
DOCUMENTS_DB_USER=documents
DOCUMENTS_DB_PASSWORD=CHANGE_ME_DOCS_DB

# --- Django ---
NSI_DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET_MIN_50_CHARS_________________
DOCS_DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET_MIN_50_CHARS_________________

# Список Host-заголовков через запятую (домен сайта + 127.0.0.1 для смоук с хоста).
DJANGO_ALLOWED_HOSTS=converter.example.com,127.0.0.1,localhost

# CORS: только доверенные origin фронта (HTTPS).
CORS_ALLOWED_ORIGINS=https://converter.example.com

# Keycloak OIDC: публичные URL (через Nginx /realms/...).
KEYCLOAK_ISSUER=https://converter.example.com/realms/uom
KEYCLOAK_JWKS_URL=https://converter.example.com/realms/uom/protocol/openid-connect/certs

# СБ (прод): ожидаемые значения claim aud в access token (через запятую). Пусто = как в dev (проверка aud отключена).
# Узнать фактический aud: декодировать токен в jwt.io или смотреть mappers клиента в Keycloak.
# KEYCLOAK_JWT_AUDIENCE=account

# Админ-API Keycloak (сервисы создают клиентов/роли): внутри compose — http://keycloak:8080
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080

# --- Строки подключения приложений (внутри docker-сети) ---
NSI_DATABASE_URL=postgres://nsi:CHANGE_ME_NSI_DB@nsi_db:5432/nsi
DOCUMENTS_DATABASE_URL=postgres://documents:CHANGE_ME_DOCS_DB@documents_db:5432/documents

CELERY_BROKER_URL=amqp://converter_mq:CHANGE_ME_LONG_RANDOM@rabbitmq:5672//

# S2S: секрет клиента documents-service в Keycloak (не хранить в Git).
S2S_CLIENT_SECRET=CHANGE_ME_S2S_SECRET

# URL сервисов: снаружи — через Nginx; внутри сети compose — короткие имена.
CONVERSION_BASE_URL=http://conversion:8000
# Токен для S2S из контейнера documents → Keycloak: внутренний URL (не гонять через публичный Nginx без необходимости).
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/uom/protocol/openid-connect/token
NSI_BASE_URL=http://nsi:8000

# MinIO: браузер ходит на S3 API через Nginx или отдельный поддомен — указать host:port без схемы.
MINIO_PUBLIC_ENDPOINT=converter.example.com:9000
MINIO_PUBLIC_SECURE=1

# Опционально переопределить внутренний endpoint (по умолчанию minio:9000 в compose).
# MINIO_INTERNAL_ENDPOINT=minio:9000

# Внутренние URL для bootstrap-профиля seed (docker compose --profile bootstrap run --rm seed)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
NSI_INTERNAL_URL=http://nsi:8000
DOCUMENTS_INTERNAL_URL=http://documents:8000

# Пароль первичного пользователя после seed (сменить после первого входа + включить 2FA в Keycloak).
SEED_PASSWORD=CHANGE_ME_OPERATOR_PASSWORD
