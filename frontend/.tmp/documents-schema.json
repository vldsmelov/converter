    "components": {
        "schemas": {
            "ConvertedLine": {
                "type": "object",
                "properties": {
                    "posting_qty": {
                        "type": "string",
                        "format": "decimal",
                        "pattern": "^-?\\d{0,12}(?:\\.\\d{0,6})?$"
                    },
                    "posting_uom_code": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "steps": {},
                    "warnings": {},
                    "calculated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "calculated_at",
                    "posting_qty",
                    "posting_uom_code"
                ]
            },
            "FileTypeEnum": {
                "enum": [
                    "xlsx",
                    "pdf"
                ],
                "type": "string",
                "description": "* `xlsx` - XLSX\n* `pdf` - PDF"
            },
            "Invoice": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "number": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "supplier": {
                        "type": "string",
                        "maxLength": 256
                    },
                    "doc_date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "status": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/StatusEnum"
                            }
                        ],
                        "readOnly": true
                    },
                    "error": {
                        "type": "string",
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/InvoiceLine"
                        }
                    },
                    "files": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/InvoiceFile"
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "created_at",
                    "error",
                    "files",
                    "id",
                    "lines",
                    "number",
                    "status",
                    "updated_at"
                ]
            },
            "InvoiceFile": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "file_type": {
                        "$ref": "#/components/schemas/FileTypeEnum"
                    },
                    "file_name": {
                        "type": "string",
                        "maxLength": 256
                    },
                    "content_type": {
                        "type": "string",
                        "maxLength": 128
                    },
                    "size": {
                        "type": "integer",
                        "maximum": 9223372036854775807,
                        "minimum": -9223372036854775808,
                        "format": "int64"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "download_url": {
                        "type": "string",
                        "readOnly": true
                    },
                    "presigned_url": {
                        "type": "string",
                        "nullable": true,
                        "readOnly": true
                    }
                },
                "required": [
                    "content_type",
                    "created_at",
                    "download_url",
                    "file_name",
                    "file_type",
                    "id",
                    "presigned_url"
                ]
            },
            "InvoiceLine": {
                "type": "object",
                "properties": {
                    "line_no": {
                        "type": "integer",
                        "maximum": 2147483647,
                        "minimum": 0
                    },
                    "item_id": {
                        "type": "integer",
                        "maximum": 2147483647,
                        "minimum": -2147483648
                    },
                    "qty": {
                        "type": "string",
                        "format": "decimal",
                        "pattern": "^-?\\d{0,12}(?:\\.\\d{0,6})?$"
                    },
                    "uom_code": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "context": {},
                    "barcode": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "supplier_code": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "converted": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/ConvertedLine"
                            }
                        ],
                        "readOnly": true
                    }
                },
                "required": [
                    "converted",
                    "item_id",
                    "line_no",
                    "qty",
                    "uom_code"
                ]
            },
            "PatchedInvoice": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "number": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "supplier": {
                        "type": "string",
                        "maxLength": 256
                    },
                    "doc_date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "status": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/StatusEnum"
                            }
                        ],
                        "readOnly": true
                    },
                    "error": {
                        "type": "string",
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/InvoiceLine"
                        }
                    },
                    "files": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/InvoiceFile"
                        },
                        "readOnly": true
                    }
                }
            },
            "StatusEnum": {
                "enum": [
                    "new",
                    "calculating",
                    "calculated",
                    "generating",
                    "generated",
                    "failed"
                ],
                "type": "string",
                "description": "* `new` - New\n* `calculating` - Calculating\n* `calculated` - Calculated\n* `generating` - Generating\n* `generated` - Generated\n* `failed` - Failed"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}