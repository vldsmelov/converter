        "/api/v1/invoices/{id}/files/{file_id}/download/": {
            "get": {
                "operationId": "v1_invoices_files_download_retrieve",
                "parameters": [
                    {
                        "in": "path",
                        "name": "file_id",
                        "schema": {
                            "type": "string",
                            "pattern": "^\\d+$"
                        },
                        "required": true
                    },
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "A unique integer value identifying this invoice.",
