{
  "realm": "uom",
  "enabled": true,

  "roles": {
    "realm": [
      { "name": "nsi.ping" },
      { "name": "documents.ping" },
      { "name": "conversion.ping" },

      { "name": "nsi.uom.read" },
      { "name": "nsi.uom.write" },
      { "name": "nsi.item.read" },
      { "name": "nsi.item.write" },
      { "name": "nsi.package.read" },
      { "name": "nsi.package.write" },
      { "name": "nsi.rule.read" },
      { "name": "nsi.rule.write" }
    ]
  },

  "clients": [
    {
      "clientId": "uom-cli",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    }
  ],

  "users": [
    {
      "username": "operator",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "operator", "temporary": false }
      ],
      "realmRoles": [
        "nsi.ping",
        "documents.ping",
        "conversion.ping",
        "conversion.convert",
        "nsi.uom.read",
        "nsi.uom.write",
        "nsi.item.read",
        "nsi.item.write",
        "nsi.package.read",
        "nsi.package.write",
        "nsi.rule.read",
        "nsi.rule.write"
      ]
    }
  ]
}